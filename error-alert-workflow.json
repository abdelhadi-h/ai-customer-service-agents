    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Build ONE workflow_error_alert TEMPLATE message per owner number (runOnceForEachItem)\nconst cfg = $json;\nconst ex = $('Error Trigger').item.json;\nconst S = v => (v === null || v === undefined) ? '' : String(v).trim();\nconst clean = v => S(v).replace(/[\\r\\n]+/g, ' | ').replace(/\\t/g, ' ').replace(/ {2,}/g, ' ').trim().slice(0, 900) || '-';\nconst e = (ex.execution && ex.execution.error) || {};\nconst params = [\n  ex.workflow && ex.workflow.name,\n  (ex.execution && ex.execution.lastNodeExecuted) || (e.node && e.node.name),\n  e.message || e.description,\n  ex.execution && ex.execution.url\n].map(clean);\nconst nums = S(cfg.cfg_owner_wa_id).split(/[,;]+/).map(x => x.split('').filter(c => c >= '0' && c <= '9').join('')).filter(x => x.length >= 8);\nconst uniq = nums.filter((x, i) => nums.indexOf(x) === i);\nconst mk = to => ({ to, payload: { messaging_product: 'whatsapp', recipient_type: 'individual', to, type: 'template', template: { name: 'workflow_error_alert', language: { code: 'ar' }, components: [{ type: 'body', parameters: params.map(text => ({ type: 'text', text })) }] } } });\nconst alerts = uniq.length ? uniq.map(mk) : [{ to: '', payload: {}, no_owner: true }];\nreturn { json: { params, alerts } };\n"
      },
      "id": "a409d310-423a-4e18-b1bf-66005008307b",
      "name": "Prep Error Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "fieldToSplitOut": "alerts",
        "options": {}
      },
      "id": "2af3b00d-ccf5-405f-bfb6-63e207c96b24",
      "name": "Split Owner Numbers",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1.1,
      "position": [
        672,
