        "options": {}
      },
      "id": "35a4bfcd-a3e7-4820-add8-9a64aadede5c",
      "name": "Send Error Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        896,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Collapse per-recipient sends into ONE item\nfunction S(v) { return (v === null || v === undefined) ? '' : String(v).trim(); }\nconst sent = $input.all();\nconst al = $('Split Owner Numbers').all();\nconst prep = $('Prep Error Alert').first().json;\nconst ex = $('Error Trigger').first().json;\nconst failures = [];\nsent.forEach((r, i) => {\n  const a = (al[i] && al[i].json) || {};\n  const e = r.json && r.json.error;\n  if (a.no_owner) failures.push('cfg_owner_wa_id is empty or invalid');\n  else if (e) failures.push(a.to + ': ' + S(typeof e === 'string' ? e : (e.message || JSON.stringify(e))).slice(0, 300));\n});\nconst nl = String.fromCharCode(10);\nreturn [{ json: {\n  failed: failures.length > 0, failures, fail_text: failures.join(' ; ').slice(0, 900),\n  alert_status: failures.length ? ('FAILED: ' + failures.join(' ; ').slice(0, 400)) : 'sent',\n  workflow: S(ex.workflow && ex.workflow.name),\n  node: S(ex.execution && ex.execution.lastNodeExecuted),\n  error_message: S(ex.execution && ex.execution.error && ex.execution.error.message).slice(0, 900),\n  execution: S(ex.execution && (ex.execution.url || ex.execution.id)),\n  fallback_text: '❗ ' + (prep.params || []).join(nl)\n}, pairedItem: { item: 0 } }];\n"
      },
      "id": "36989462-20fc-4685-a8cb-fd45a301eb2e",
